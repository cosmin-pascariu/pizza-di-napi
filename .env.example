# PayPal sandbox credentials — create an app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# Same client id, exposed to the browser for the PayPal JS SDK buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-sandbox-client-id

# Gemini API key (free tier) — create one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Optional: model to use (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Kitchen dashboard (/admin). REQUIRED in production: without it the kitchen stays locked.
# Use at least 8 characters. In local development the kitchen is open when this is unset.
ADMIN_PIN=change-me-please
# Optional: secret used to sign kitchen sessions (defaults to one derived from ADMIN_PIN).
# Generate one with: openssl rand -base64 32
# ADMIN_SESSION_SECRET=

# Optional overrides
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# DATA_DIR=./data
